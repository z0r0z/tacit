# Read by `npm run panel` (publishes the verification panel in #verify).
DISCORD_TOKEN=
# Copy the #verify channel ID (Developer Mode > right-click channel > Copy Channel ID).
DISCORD_VERIFY_CHANNEL_ID=
# After the first publish, save the printed ID here to edit the existing panel.
DISCORD_VERIFY_MESSAGE_ID=
# Only needed by `npm run register`, the optional /verify fallback.
DISCORD_CLIENT_ID=

# The role grant and the interactions endpoint run in tacit-api (worker/src/index.js), which reads:
#   DISCORD_PUBLIC_KEY   the application's public key (Developer Portal > General Information)
#   DISCORD_BOT_TOKEN    the same value as DISCORD_TOKEN above
#   TAC_ROLE_ID          the role granted to a verified holder
#   GOV_TAC_ERC20_MAINNET canonical public TAC token (see README.md)
#   DISCORD_VERIFY_CHANNEL_ID optional: restrict verification interactions to #verify
#   DAPP_URL             optional, defaults to https://tacit.finance
# The application's Interactions Endpoint URL is https://api.tacit.finance/discord/interaction
