# Repo-root build context is used by worker-relay/Dockerfile.btc-pool, worker-relay/Dockerfile.sats-faucet,
# worker-relay/Dockerfile.evm-pool-keeper and tools/tac-vault-keeper-render/Dockerfile; everything else is excluded.
# A file a Dockerfile COPYs or a service imports has to be named here (worker-relay/tests/dockerfile-imports.test.mjs checks that it is).
*
!worker-relay/package.json
!worker-relay/package-lock.json
!worker-relay/src
!worker/package.json
!worker/package-lock.json
!worker/src/btc-shielded-pool.js
!dapp/package.json
!dapp/*.js
!dapp/vendor/*.js
!dapp/trade/rpc.js
!dapp/evm-pool/token-pool-code.json
!dapp/btc-pool/pin.json
!dapp/btc-pool/vk.bin
!dapp/btc-pool/params-k13.bin
!dapp/btc-pool/btc_pool_halo2.js
!dapp/btc-pool/btc_pool_halo2_bg.wasm
!tools/tac-vault-keeper.mjs
!tools/tac-vault-keeper-render/start.sh
