# Repo-root build context is used only by worker-relay/Dockerfile.btc-pool and worker-relay/Dockerfile.sats-faucet;
# everything else is excluded.
*
!worker-relay/package.json
!worker-relay/src
!worker/package.json
!worker/package-lock.json
!worker/src/btc-shielded-pool.js
!dapp/package.json
!dapp/*.js
!dapp/vendor/*.js
!dapp/btc-pool/pin.json
!dapp/btc-pool/spend_dev_signet_vk.json
