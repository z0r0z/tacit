# gen4 vanity CREATE3 salts. Caller-locked to DEPLOYER_ADDR (front-run-proof: only that address can land
# them). Mined with createXcrunch (RunPod tacit-confidence, RTX A4500) 2026-09-07, verified live against
# CreateX.computeCreate3Address on Ethereum mainnet, and confirmed empty (unconsumed) at read time.
export DEPLOYER_ADDR=0x68575B073DE49a94e3E3ACf6F3A0d6E3b66267C7
export SALT_POOL=0x68575b073de49a94e3e3acf6f3a0d6e3b66267c70012defaf30d084900d37c45          # => 0x0000000098A73197B3255aD9db1ed8544410f5Ba
export SALT_ENGINE=0x68575b073de49a94e3e3acf6f3a0d6e3b66267c700ab13ee5fa5056d00bd419a        # => 0x000000008cAD17f5BB485A7D521E89A9C4716cC0
export SALT_ROUTER=0x68575b073de49a94e3e3acf6f3a0d6e3b66267c7001bd2789aad1b320220adb6        # => 0x00000000F104E2C1ebe9693eD19491b9897a8193
export SALT_RELAYER=0x68575b073de49a94e3e3acf6f3a0d6e3b66267c7009b6013984e38a40277d36f       # => 0x00000000705D345449950e900271F27E7fEEABc5
export SALT_BTC_CALL_EXECUTOR=0x68575b073de49a94e3e3acf6f3a0d6e3b66267c70037bcd54830679b0173c30d  # => 0x00000000f448614cc7b5152f108471f020a97D13
export SALT_PUBLIC_AMM=0x68575b073de49a94e3e3acf6f3a0d6e3b66267c70083bc176282e2f2004cb191    # => 0x00000000265b57fD310eBEa4330fD8B07c0d3421
# CANONICAL_FACTORY, SP1_VERIFIER, HEADER_RELAY are chain-wide/generation-agnostic and reused from gen3.
# DEPLOY_ETH_CALL_OUTBOX=false reuses gen3's EthCallOutbox (its address is pinned inside the eth-reflection
# guest ELF itself; a fresh one would need that separate guest rebuilt too). POOL/ENGINE/ROUTER/RELAYER/
# BTC_CALL_EXECUTOR each immutably bind the pool address at construction, so each needs a fresh salt every
# generation; PUBLIC_AMM does not (its ctor only takes the deployer), mined anyway to match gen3's precedent.
