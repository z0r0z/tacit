# Factory salt intentionally unset — CANONICAL_FACTORY reuse takes precedence.

# ── LIVE-STATE args — DERIVE AT CUTOVER, AFTER FREEZING THE REFLECTION FOLDER ──
# 1. Stop the worker-relay reflection Background Worker (freeze knownReflectionDigest).
# 2. REFLECTION_RESUME_DIGEST = old pool's frozen digest:
#      cast storage 0x0000000000c5B537A7c3622d1418D5771914C03D 80 --rpc-url $RPC
#    (reads 0x0df5dd17… right now — re-read AFTER freeze and paste the frozen value)
export REFLECTION_RESUME_DIGEST=0x64b3ae2abd94812c8a139f93d7da049cfee12354a9116a01444d5a7c05fb3825  # @958151 seed, verified (TAC folded in)
# 3. GENESIS_REFLECTION_ANCHOR = little-endian INTERNAL btc block hash at that reflected tip
#    (from the last attest's BitcoinReflectionPublicValues, or the relay header at the
#    reflected height ~958735). MUST be a header HEADER_RELAY knows; ctor hard-checks it.
export GENESIS_REFLECTION_ANCHOR=0x4db866736b671463a25b32f1d8c8c534b7056159522201000000000000000000  # block 958151, relay-known

# ── Fork-gate inputs (first-attest proof at the NEW vkey, from the rebuilt bitcoin_prove) ──
export ATTEST_PV=0x__FIRST_ATTEST_PUBLIC_VALUES__
export ATTEST_PROOF=0x__FIRST_ATTEST_PROOF_BYTES__

# ── RPCs / deploy knobs ──
export RPC=https://ethereum-rpc.publicnode.com
export MAINNET_RPC=$RPC
export REQUIRE_VANITY=true       # ctor enforces vanity on chainid 1
# ETHERSCAN_API_KEY=…            # for --verify

# ─────────────────────────────────────────────────────────────────────────────
# COMMAND SEQUENCE (run from contracts/, after sourcing this file + the frozen values)
#
#  # A. Preflight — deploy on a fork + run the REAL first attest. Revert => DO NOT DEPLOY.
#  forge script script/ForkAttestGate.s.sol:ForkAttestGate --fork-url $MAINNET_RPC -vvv
#
#  # B. Broadcast the suite (needs the deployer key; pool fits EIP-170 by 23 B).
#  forge script script/DeployV1SuiteCreateX.s.sol:DeployV1SuiteCreateX \
#    --rpc-url $RPC --broadcast --slow \
#    --private-key $DEPLOYER_KEY   # or --ledger / --account
#
#  # C. Post-deploy: repoint worker (POOL_ADDR=0x…0f5de1), ship new prover-bins,
#  #    resume folder from REFLECTION_RESUME_DIGEST, unfreeze.
# ─────────────────────────────────────────────────────────────────────────────

