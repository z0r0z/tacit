export SALT_ROUTER=0x68575b073de49a94e3e3acf6f3a0d6e3b66267c700fa11ad7d2a2215013e0c4a          # => router  0x000000000074671c272b4e5de166b817e77ea75c
export SALT_RELAYER=0x68575b073de49a94e3e3acf6f3a0d6e3b66267c70081baebca24fcaa02eb63c3         # => relayer 0x0000000000ad504de42dc489a1a5842fc9c36f99
