# ─────────────────────────────────────────────────────────────────────────────
# Tacit V1 — FINAL canonical mainnet launch env (2026-08-27).
# Canonical vanity salts (permissioned, caller = deployer 0x68575B07…67C7) + reproved swapbatch/tips
# vkeys + fresh BitcoinLightRelay + fresh reflection genesis. Deploys a FRESH factory (no reuse).
#
#   source deployments/launch-v1-final.env
#   READINESS_STRICT=1 bash sp1/confidential/readiness-gate.sh
#   VERIFY_VKEY_STRICT=1 bash sp1/confidential/verify-vkey-pin.sh
#   forge script script/DeployV1SuiteCreateX.s.sol --rpc-url "$MAINNET_RPC" \
#       --sender "$DEPLOYER_ADDR" --private-key "$DEPLOYER_PRIVATE_KEY" --broadcast --verify
# ─────────────────────────────────────────────────────────────────────────────

# ── REMINED 2026-09-17: every address below in the prior remine (2026-08-27) was found to ALREADY HAVE
#    CODE on live mainnet (all 7 non-factory slots) — confirmed via eth_getCode immediately before this
#    remine, so those old salts are BURNED/consumed and could not be reused. Fresh salts mined via
#    createxcrunch (GPU, box tacit-confidence, `-c $DEPLOYER_ADDR -z 4`) and independently confirmed EMPTY
#    on live mainnet via eth_getCode right after mining, before being written here. SALT_FACTORY unchanged
#    (canonical factory, reused as before, never consumed by this). ──
export SALT_FACTORY=0x68575b073de49a94e3e3acf6f3a0d6e3b66267c7002953dd7f23f45503d925fd          # => 0x0000000042c2d57499df64baf81bfa2c6e100535
export SALT_ADAPTER=0x68575b073de49a94e3e3acf6f3a0d6e3b66267c700ec3000183e14fd03ae98e5          # => 0x000000005010e4a43e83a658d36bf3adb38ed62c
export SALT_ENGINE=0x68575b073de49a94e3e3acf6f3a0d6e3b66267c700ec177948ae55d401e57fc1           # => 0x000000003f608bddf0ca45934003ffb9dbdf70db
export SALT_ROUTER=0x68575b073de49a94e3e3acf6f3a0d6e3b66267c700389e396a680aef023f4a0a           # => 0x000000005da3e3b73726af3c774deeb9472d4992
export SALT_RELAYER=0x68575b073de49a94e3e3acf6f3a0d6e3b66267c7002554b13be51ac00352838c          # => 0x000000009c28617ac88b52eae5efaacdd4ac34c3
export SALT_BTC_CALL_EXECUTOR=0x68575b073de49a94e3e3acf6f3a0d6e3b66267c700d70d5480ec847801fb9439 # => 0x00000000df8263ac5810c53b31aae20ee53c247f
export SALT_POOL=0x68575b073de49a94e3e3acf6f3a0d6e3b66267c7003d9e65453cbe3a03f800c2   # => 0x000000000ed1eabd231be41d93b719056f7febfc
# ETH_CALL_OUTBOX: the OLD salt above (embedding deployer 0x42e7b9e9...) turned out to be genuinely
# sender-locked (this project's guardRandom() only matches real CreateX guard semantics when the salt's
# embedded prefix IS the actual broadcasting sender — confirmed via a live dry-run mismatch, not merely
# theorized) — since we do not control that key, it was UNREACHABLE from our real deployer. Re-pinned
# 2026-09-17 to a fresh address mined for the correct deployer (0x68575B073DE49a94e3E3ACf6F3A0d6E3b66267C7)
# and re-baked into contracts/sp1/confidential/src/reflect.rs's ETH_CALL_OUTBOX const (scoped
# reflection-only reprove; settle + eth-reflection guests are unaffected, their vkeys unchanged).
export SALT_ETH_CALL_OUTBOX=0x68575b073de49a94e3e3acf6f3a0d6e3b66267c7000326fb99fa8e9a005a64b9   # => 0x00000000a26a6e291972666a9687741dba11af46 (GUEST-PINNED reflect.rs — must match exactly)

# CbtcEscrowHelper — deployed SEPARATELY via DeployCbtcEscrowHelperCreateX.s.sol (not part of
# DeployV1SuiteCreateX), run AFTER the engine above lands (its constructor binds to the engine's real
# address, so COLLATERAL_ENGINE below must be updated to the ACTUAL deployed engine address, not just
# the predicted one, before broadcasting this one).
export SALT_CBTC_ESCROW_HELPER=0x68575b073de49a94e3e3acf6f3a0d6e3b66267c7004da3e8ffc430c50270cc5e   # => 0x00000000689c71e690e5842df088af97f9d4f71b
export EXPECTED_CBTC_ESCROW_HELPER=0x00000000689c71e690e5842df088af97f9d4f71b
# COLLATERAL_ENGINE=<set to the real deployed engine address at cutover time>  (predicted: 0x000000003f608bddf0ca45934003ffb9dbdf70db)
# publicAmm — the pool's immutable publicAmm_ (Finding-1 component). Bound to the pool by address, not
# vanity, so any caller-prefixed salt works — but the OLD salt's address was already consumed on mainnet
# (same as the rest of the pre-2026-09-17 set), so this was re-mined with 4 leading zero bytes for
# consistency with the rest of the suite.
export SALT_PUBLIC_AMM=0x68575b073de49a94e3e3acf6f3a0d6e3b66267c700f978b314563a5103b3efb4   # => 0x00000000e36c7ec997cc59dcda9e03673b448119

# ── Verifier (reused) + reproved vkeys (elf-vkey-pin.json: v1-final pre-lock closing review, 2026-09-17) ──
export SP1_VERIFIER=0xb69f2584CBcFf99a58C4e7002E8b89Af54a6f4e2
export EXPECTED_VERIFIER_CODEHASH=0xcceb864cd8a5a36b2073a8f2b32a773835cd2dd2c78a56f8e6fdb942feff04dd
export PROGRAM_VKEY=0x006cd47fd23937a6d247696cace28c22d2c6a8280447e6ac45a3571de232d6e3
export BITCOIN_RELAY_VKEY=0x00bb158ba04f18a100f998af0e3b074b5368771f22b8b6e4fd1d66823a074bc5

# LIVE CAPTURE 2026-09-17 (session tacit-3d): gen4 read at Bitcoin height 967040 (attestedHeight ==
# tipHeight, i.e. gen4 was FULLY caught up to the header-relay's own tip at capture time — no catch-up gap
# baked into this generation's genesis). Drain gate independently confirmed PASS: on-chain
# attestedBitcoinConsumedCount=1 == gen4's folded consumedCount=1 (exact match required); on-chain
# attestedCrossOutCount=6 == gen4's folded foldedCrossoutCount=6 (>= required, satisfied with equality).
# Anchor cross-checked against 2 independent explorers (blockstream.info + mempool.space) AND against the
# live deployed BitcoinLightRelay's own blockHeight() getter (returns 967040 for the internal-byte-order
# hash below — confirmed relay-known, satisfying the deploy script's RELAY.blockHeight(anchor) != 0 assert).
# REFLECTION_RESUME_DIGEST is state.rebase().digest() of gen4's real live snapshot (globals preserved,
# generation-local fields reset) with the 250,000 TAC recovery note merged in — independently re-derived
# from scratch (public data only, no secret material) and confirmed to match byte-for-byte before use.
export HEADER_RELAY=0x20A6ddc2C6E620c6248B5A34E85996516FDd19D0
export GENESIS_REFLECTION_ANCHOR=0xb474becfaf307d539b8fc7849aeee62d4e8f1494fa1501000000000000000000
export REFLECTION_RESUME_DIGEST=0xe0a964d4cd62fcbe8a801482db9869fea7482827b80b772aa81532f25ce10c3b
export RESUME_DIGEST_HEIGHT=967040
export REFLECTION_CONFIRMATIONS=24   # finality depth against a privately mined branch while the header feeders idle
export SYNC_COMMITTEE_MODE=chained   # eth-reflection prover-host: resume from the committed state's last landed slot (was manual-only; now wired here)

# ── Other externals / admin ──
export TETH_BITCOIN_ID=0x3cba71e1114af183cdeacc6b8457a474d17529fd28704480ca799d0d03126f34
export ENGINE_ADMIN=0x006CD14F36F65eCbB29b2519cCBe63A0DC8549F2   # == MAINNET_OPS_MULTISIG (required on mainnet)
# NO CANONICAL_FACTORY / EXPECTED_FACTORY_CODEHASH => deploy a FRESH factory via SALT_FACTORY.

# ── RPCs / knobs ──
export RPC=https://ethereum-rpc.publicnode.com
export MAINNET_RPC=$RPC
export REQUIRE_VANITY=true
