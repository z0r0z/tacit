export GENESIS_REFLECTION_ANCHOR=0xbc41f8a9505208c375e3d4619acf7665735ec8e16e8000000000000000000000
export REFLECTION_RESUME_DIGEST=   # EMPTY => REFLECTION_GENESIS_DIGEST (fresh, empty reflected state)
