# pool — 5 zero bytes; FILLED when the z=5 miner lands (placeholder rejected by REQUIRE_VANITY until then).
export SALT_POOL=0x68575b073de49a94e3e3acf6f3a0d6e3b66267c700b1724495ba4706029763d2   # => 0x000000000090dD044aCdA57302B3892E60B7807d
export SALT_ETH_CALL_OUTBOX=0x68575b073de49a94e3e3acf6f3a0d6e3b66267c700febc67ff597bf4010cf226   # => 0x00000000002c40c367ed873136e17151652de080 (GUEST-PINNED reflect.rs:435 — REUSED, still empty on-chain)
# publicAmm — the pool's immutable publicAmm_ (Finding-1 component). Bound to the pool by address, not
# vanity, so any caller-prefixed salt works.
export SALT_PUBLIC_AMM=0x68575b073de49a94e3e3acf6f3a0d6e3b66267c700000000000000007075616d   # => 0x97eCbbe0bD0924064C8c1CEB505C2466F1eDfCf9 (no vanity; bound by address)

