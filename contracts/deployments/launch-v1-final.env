# ─────────────────────────────────────────────────────────────────────────────
# Tacit V1 — FINAL canonical mainnet launch env (2026-08-27).
# Canonical vanity salts (permissioned, caller = deployer 0x68575B07…67C7) + reproved swapbatch/tips
# vkeys + fresh BitcoinLightRelay + fresh reflection genesis. Deploys a FRESH factory (no reuse).
#
#   source deployments/launch-v1-final.env
#   READINESS_STRICT=1 bash sp1/confidential/readiness-gate.sh
#   VERIFY_VKEY_STRICT=1 bash sp1/confidential/verify-vkey-pin.sh
#   forge script script/DeployV1SuiteCreateX.s.sol --rpc-url "$MAINNET_RPC" \
#       --sender "$DEPLOYER_ADDR" --private-key "$DEPLOYER_PRIVATE_KEY" --broadcast --verify
# ─────────────────────────────────────────────────────────────────────────────

# ── FRESH remine 2026-08-27 (prior launch-permissioned salts were CONSUMED by the Jul 24 test suite).
#    Periphery = 4 zero bytes (0x00000000…); pool = 5 zero bytes (0x0000000000…, mining). ──
export SALT_FACTORY=0x68575b073de49a94e3e3acf6f3a0d6e3b66267c7002953dd7f23f45503d925fd          # => 0x0000000042c2d57499df64baf81bfa2c6e100535
export SALT_ADAPTER=0x68575b073de49a94e3e3acf6f3a0d6e3b66267c7003f65f9cd80001b003e0f33          # => 0x00000000d5dc070d2732dc0437a153d3f9cf8120
export SALT_ENGINE=0x68575b073de49a94e3e3acf6f3a0d6e3b66267c7007c0dfb1b04d82b003f511c           # => 0x000000003c544317adc8e608ace304bb77e769f3
export SALT_ROUTER=0x68575b073de49a94e3e3acf6f3a0d6e3b66267c7007e03409e40dfb6006bcebd           # => 0x00000000130605b859ab160186687b097a1a4435
export SALT_RELAYER=0x68575b073de49a94e3e3acf6f3a0d6e3b66267c700d723f9388f7f50036bb357          # => 0x0000000058cc2fbe1f826eacd8824edc13f1e696
