export SALT_ADAPTER=0x68575b073de49a94e3e3acf6f3a0d6e3b66267c7003e887e8eeee333016f4974   # => 0x0000000000bfa0573fa22daed427545baa9b18cf
export SALT_ROUTER=0x68575b073de49a94e3e3acf6f3a0d6e3b66267c700406ea034403367031713dd   # => 0x0000000000e5ddd55200cebc488f9cb22d85476f
export SALT_RELAYER=0x68575b073de49a94e3e3acf6f3a0d6e3b66267c70055c10a5cd65e7d02138f29   # => 0x00000000004595e35fc6e0a94d428a9d5677ad10
