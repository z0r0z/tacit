# ─────────────────────────────────────────────────────────────────────────────
# Tacit V1 — the actual canonical launch pool (prior on-chain pools were test-in-prod, NOT a generation
# to resume from). FRESH REFLECTION GENESIS: reflectionResumeDigest = 0 ⇒ the ctor seeds
# knownReflectionDigest = REFLECTION_GENESIS_DIGEST (the empty-state digest the guest computes,
# genesis_digest_matches_contract_constant). The reflection lane starts empty at a RECENT matured Bitcoin
# anchor — no state to fold in, so no big-fold / OOM risk. predecessor = 0 (no rebase).
# ─────────────────────────────────────────────────────────────────────────────

# ── Verifier (reused) + vkeys (from elf-vkey-pin.json — swapbatch + gasless-tips reprove) ──
export SP1_VERIFIER=0xb69f2584CBcFf99a58C4e7002E8b89Af54a6f4e2
export EXPECTED_VERIFIER_CODEHASH=0xcceb864cd8a5a36b2073a8f2b32a773835cd2dd2c78a56f8e6fdb942feff04dd
export PROGRAM_VKEY=0x0082db7e3c32c8a865ddecc8f5236b1fb86339aeb94d198c68674538e3eb4727   # settle guest (prover-blind swap batch + gasless tips)
export BITCOIN_RELAY_VKEY=0x00edafc6bb483778bf126be1c810fb7bda29cdb7996cd1ecb5a8896aac0c4f05  # reflection guest (Track-C swap_batch fold re-armed)

# ── Reuse existing externals (factory is pool-agnostic) ──
export CANONICAL_FACTORY=0x0000000000b62AEC1ADfF36E80b54CACbfAF8F90
export EXPECTED_FACTORY_CODEHASH=0xb77d85278d7248a99f30f2762ff2f25c64331607c8702bec1a28463bfb359b30  # on-chain codehash of the reused factory (impostor guard)
export HEADER_RELAY=0x1677A5A3669a6D365431e916678566DAaa2e9094
export TETH_BITCOIN_ID=0x3cba71e1114af183cdeacc6b8457a474d17529fd28704480ca799d0d03126f34
export ENGINE_ADMIN=0x006CD14F36F65eCbB29b2519cCBe63A0DC8549F2
export REFLECTION_CONFIRMATIONS=6

# ── FRESH-GENESIS reflection anchor (set GENESIS_REFLECTION_ANCHOR at broadcast; resume digest stays 0) ──
# REFLECTION_RESUME_DIGEST is intentionally EMPTY ⇒ bytes32(0) ⇒ the ctor uses REFLECTION_GENESIS_DIGEST.
# This is CORRECT for a fresh launch (empty reflected state) — it is NOT a full-history replay: the first
# attest folds forward from GENESIS_REFLECTION_ANCHOR on an empty state, so there is no large catch-up.
export REFLECTION_RESUME_DIGEST=   # leave EMPTY for a fresh genesis (⇒ REFLECTION_GENESIS_DIGEST)
#
# GENESIS_REFLECTION_ANCHOR = a RECENT matured Bitcoin block hash the relay knows: relay.tip() walked back
# REFLECTION_CONFIRMATIONS (6), in LITTLE-ENDIAN INTERNAL byte order (relay byte order, NOT the display hash).
# The deploy staticcalls relay.blockHeight(anchor) != 0 (byte-order + relay-known guard) and the ctor rejects
# a zero anchor when reflection is on. Set it fresh at broadcast:
#   ANCHOR_LE=$(cast call $HEADER_RELAY 'tip()(bytes32)' --rpc-url $RPC)   # already LE-internal
#   then walk back 6 matured blocks (the relay's canonical ancestors) and use that hash.
# Ensure the relay is CURRENT first (its tip within a few blocks of the real Bitcoin tip); submit headers or
# deploy/point a fresh relay if it lags, so the anchor is recent and the first fold is small.
export GENESIS_REFLECTION_ANCHOR=  # <-- fill at broadcast (recent matured tip, little-endian internal hash)

# ── Vanity salts (PENDING mining: createXcrunch --caller 0x68575B --leading 5, round-3 permissioned set) ──
export SALT_POOL=0x68575b073de49a94e3e3acf6f3a0d6e3b66267c700caef5348dfa0ed03c11a6a
# Public-AMM periphery — the pool's immutable publicAmm_. Bound to the pool by address (not vanity), so any
# caller-prefixed salt works; no 4-zero-byte grind needed. CREATE3 ⇒ its address is a pure function of this salt.
export SALT_PUBLIC_AMM=0x68575b073de49a94e3e3acf6f3a0d6e3b66267c70000000000000000007075616d
export SALT_ENGINE=0x68575b073de49a94e3e3acf6f3a0d6e3b66267c70029396d51509b0a01f1dda8   # => 0x00000000003db970e4863e2b8663334cfe501052
export SALT_ADAPTER=0x68575b073de49a94e3e3acf6f3a0d6e3b66267c7003e887e8eeee333016f4974   # => 0x0000000000bfa0573fa22daed427545baa9b18cf
export SALT_ROUTER=0x68575b073de49a94e3e3acf6f3a0d6e3b66267c700406ea034403367031713dd   # => 0x0000000000e5ddd55200cebc488f9cb22d85476f
export SALT_RELAYER=0x68575b073de49a94e3e3acf6f3a0d6e3b66267c70055c10a5cd65e7d02138f29   # => 0x00000000004595e35fc6e0a94d428a9d5677ad10
export SALT_BTC_CALL_EXECUTOR=0x68575b073de49a94e3e3acf6f3a0d6e3b66267c70067ad2c909fef1b02b722d2   # => 0x000000000008338abe460ec9e8251e9105af65a2
# Factory salt unset — CANONICAL_FACTORY reuse takes precedence.

# ── RPCs / deploy knobs ──
export RPC=https://ethereum-rpc.publicnode.com
export MAINNET_RPC=$RPC
export REQUIRE_VANITY=true

