pragma solidity ^0.8.28;

import {Script, console2} from "forge-std/Script.sol";
import {ConfidentialPool} from "../src/ConfidentialPool.sol";

/// @dev One-off diagnostic: decode a real settle() calldata blob's PublicValues.bitcoinConsumedSources,
///      to recover the exact witness value needed for the eth-reflection consumed-ν fix. Not part of the
///      deploy suite — run via `forge script` locally, never broadcast.
contract DecodeConsumedSource is Script {
    function run() external pure {
        bytes memory pvBytes =
            hex"";
        // pvBytes above is the FULL settle(bytes,bytes,bytes[]) calldata (selector + outer args). Strip the
        // 4-byte selector, decode the outer tuple to get the inner `publicValues` blob, then decode that.
        bytes memory outer = new bytes(pvBytes.length - 4);
        for (uint256 i = 0; i < outer.length; i++) {
            outer[i] = pvBytes[i + 4];
        }
        (bytes memory publicValues,,) = abi.decode(outer, (bytes, bytes, bytes[]));
        console2.log("publicValues length:", publicValues.length);
        console2.logBytes(publicValues);
    }
}
