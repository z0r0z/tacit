# tacit-btc-pool: Bitcoin-native shielded pool replay (src/btc-pool-indexer.js).
# Build context is the repo root: the service imports worker/src/btc-shielded-pool.js and the dapp's pool modules
# (proof verification runs in process on the Halo2 wasm in dapp/btc-pool/ against the key pinned in
# dapp/btc-pool/pin.json), so the runtime image keeps that layout.
#   docker build -f worker-relay/Dockerfile.btc-pool .

FROM node:20-bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app

COPY worker/package.json worker/package-lock.json /app/worker/
RUN cd /app/worker && npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY worker/src/btc-shielded-pool.js /app/worker/src/btc-shielded-pool.js

COPY dapp/package.json /app/dapp/package.json
COPY dapp/*.js /app/dapp/
COPY dapp/vendor/*.js /app/dapp/vendor/
# Pin, verification key, params and the verifier wasm (the same files wallets prove with).
COPY dapp/btc-pool/pin.json dapp/btc-pool/vk.bin dapp/btc-pool/params-k13.bin dapp/btc-pool/btc_pool_halo2.js dapp/btc-pool/btc_pool_halo2_bg.wasm /app/dapp/btc-pool/

WORKDIR /app/worker-relay
COPY worker-relay/package.json ./
RUN npm install --omit=dev && npm cache clean --force
COPY worker-relay/src ./src

# The pinned key must load and verify here, or the image is unusable.
RUN node -e "import('./src/lib/btc-pool-verify.js').then(async (m) => { const v = m.makeBtcPoolVerifier({ network: 'signet', log() {} }); if (!v.enabled) { console.error(v.reason); process.exit(1); } await v.ready(); console.log('verifier', v.system.id, v.vkHash.slice(0, 16)); })"

ENV NODE_ENV=production \
    BTC_POOL_DB=/var/lib/tacit-btc-pool/btc-pool.db \
    PORT=10000
EXPOSE 10000
CMD ["node", "src/btc-pool-indexer.js"]
