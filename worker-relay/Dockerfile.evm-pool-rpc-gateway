# tacit-evm-pool-rpc: the gateway for a wallet's own chain reads on the private route (src/evm-pool-rpc-gateway.js). A forwarder carries a sealed request to it;
# it answers reads from public nodes. It holds no funds and no user key.
# Build context is the repo root.
#   docker build -f worker-relay/Dockerfile.evm-pool-rpc-gateway .
#   docker run -p 10000:10000 -e RPC_GATEWAY_KEY=<32 bytes hex> -e RPC_GATEWAY_NODES='{"1":["https://…"]}' <image>

FROM node:20-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app

COPY dapp/package.json /app/dapp/package.json
COPY dapp/sealed-request.js dapp/relay-gateway-doc.js /app/dapp/
COPY dapp/vendor/tacit-deps.min.js /app/dapp/vendor/tacit-deps.min.js

WORKDIR /app/worker-relay
COPY worker-relay/package.json ./package.json
COPY worker-relay/src/evm-pool-rpc-gateway.js ./src/evm-pool-rpc-gateway.js
COPY worker-relay/src/lib/evm-pool-keeper-sealed.js worker-relay/src/lib/evm-pool-keeper-rpc.js worker-relay/src/lib/token-bucket.js worker-relay/src/lib/safe-err.js ./src/lib/

# The shared modules must load here, or the image is unusable.
RUN node -e "import('./src/evm-pool-rpc-gateway.js').then((m) => { if (typeof m.makeRpcGateway !== 'function') process.exit(1); console.log('rpc gateway ok'); })"

ENV NODE_ENV=production \
    PORT=10000
EXPOSE 10000
CMD ["node", "src/evm-pool-rpc-gateway.js"]
