# Copy to .env (bootstrap.sh does it and fills the secrets). Never commit the real one.
NODE_HOST=node.tacit.finance

# What the gateway fronts (the compose service names). Empty one of them on a box that runs only the other half.
ETH_UPSTREAM=http://reth:8545
BTC_RPC_URL=http://bitcoind:8332
ELECTRUM_URL=tcp://electrs:50001

# Browsers allowed to read (CORS). '*' would make us everyone's free node.
ALLOW_ORIGINS=https://tacit.finance,https://www.tacit.finance
# Per-visitor budget in units a minute (a plain read is 1, eth_call 5, eth_getLogs 10, an address's history 5) and the cap on a getLogs span.
BUDGET_PER_MIN=600
LOGS_MAX_SPAN=50000
# '1' lets a page broadcast a Bitcoin transaction through us. Off until a test broadcast of one of ours has been seen to relay.
ALLOW_BROADCAST=0

# Secrets for our own services (comma-separated, 16+ characters of [A-Za-z0-9_-]); they go in the services' URLs: https://<host>/k/<KEY>/eth
INTERNAL_KEYS=
# '1' lets a key holder send transactions through us. Visitors never can.
INTERNAL_SENDS=0
# '1' lets a key holder trace one transaction (the fast-bridge providers' FB_LP_TRACE_RPCS). The pool-calls tracer is accepted for these pools only.
INTERNAL_TRACE=1
TRACE_POOLS=0x000000000Ed1eabD231Be41d93b719056F7febFC

# bitcoind <-> electrs/gateway. bootstrap.sh makes the password and the matching rpcauth line.
BTC_RPC_USER=tacit
BTC_RPC_PASS=
BTC_RPCAUTH=
# bitcoind's cache in MB: 10000 for the first sync, then 2000 (README, "after the first sync").
BTC_DBCACHE=10000

# Where the chains live (NVMe).
CHAIN_DIR=/srv/chain
