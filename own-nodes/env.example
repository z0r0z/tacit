# Copy to .env (bootstrap.sh does it and fills the passwords). Never commit the real one.
NODE_HOST=node.tacit.finance

# What the gateway fronts. Leave one empty on a machine that runs only the other half (then start only its profile).
ETH_UPSTREAM=http://reth:8545
BTC_ESPLORA_UPSTREAM=http://electrs:3000

# Browsers allowed to read (CORS). '*' would make us everyone's free node.
ALLOW_ORIGINS=https://tacit.finance,https://www.tacit.finance
# Per-visitor budget in units a minute (a plain read is 1, eth_call 5, eth_getLogs 10) and the cap on a getLogs span.
BUDGET_PER_MIN=600
LOGS_MAX_SPAN=50000
# '1' lets the page broadcast a Bitcoin transaction through us. Off until the node's relay policy has been seen to accept ours.
ALLOW_BROADCAST=0

# Secrets for our own services (comma-separated, 16+ characters of [A-Za-z0-9_-]); they go in the services' URLs, see README.
INTERNAL_KEYS=
# '1' lets a holder of an internal key send transactions through us (the relays send through the URL they read from). Visitors never can.
INTERNAL_SENDS=0

# bitcoind <-> electrs. bootstrap.sh makes the password and the matching rpcauth line.
BTC_RPC_USER=tacit
BTC_RPC_PASS=
BTC_RPCAUTH=
# Cache for bitcoind in MB: 8000+ during the first sync (RAM permitting), 1000-2000 after.
BTC_DBCACHE=4000

# Where the chains live. NVMe. Two folders here may sit on two disks (symlink them).
CHAIN_DIR=/srv/chain
